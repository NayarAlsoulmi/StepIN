# StepIN backend configuration. Copy to .env and fill in. NEVER commit .env.

# Provider selection: "mock" (no key needed) or "production"
AI_PROVIDER=mock

# Required only when AI_PROVIDER=production
AI_PROVIDER_API_KEY=
AI_REALTIME_MODEL=
AI_ANALYSIS_MODEL=

# Server
PORT=3000
ALLOWED_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
